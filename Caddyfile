# ─────────────────────────────────────────────────────────────────────────────
# Caddy — یک فایل برای هر دو حالت؛ آدرس سایت از متغیر DOMAIN می‌آید
# (سرویس caddy در docker-compose.yml تامینش می‌کند).
#
#   لوکال:  DOMAIN=sinshin.localhost  → گواهی از CA داخلی (https خودکار)
#   سرور:   DOMAIN=food.example.com   → گواهی ACME (Let's Encrypt) خودکار
# ─────────────────────────────────────────────────────────────────────────────
{
    # ایمیل اکانت ACME — فقط برای دامنه‌ی واقعی مصرف می‌شود؛
    # برای آدرس‌های *.localhost کدی اصلاً سراغ ACME نمی‌رود.
    email {$ACME_EMAIL:dev@sinshin.localhost}
}

{$DOMAIN:sinshin.localhost} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # ── مستندات API — فقط وقتی SWAGGER_ENABLED=true ──
    # نکته: پکیج مستندسازی نصب‌شده مسیرش /openapi است (نه /swagger که
    # کد فعلی ادعا می‌کند)؛ فعلاً هر دو مسیر روت شده‌اند تا بعد از
    # صریح‌کردن مسیر در کد اپ، هر کدام بود کار کند.
    @docs_on expression `'{$SWAGGER_ENABLED:false}' == "true"`
    handle /swagger* {
        route {
            reverse_proxy @docs_on api:3000
            respond 404
        }
    }
    handle /openapi* {
        route {
            reverse_proxy @docs_on api:3000
            respond 404
        }
    }

    # ── بک‌اند — flush_interval -1 یعنی stream فوری → SSE سالم ──
    handle /api/* {
        reverse_proxy api:3000 {
            flush_interval -1
        }
    }

    # ── فرانت (TanStack Start SSR) ──
    handle {
        reverse_proxy web:3000
    }
}