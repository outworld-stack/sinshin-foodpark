# ─── سطح استقرار — فقط سرویس caddy این را می‌خواند ───
# (مخفی‌های اپ در apps/api/.env هستند؛ این فایل با آن یکی نیست)
#
# cp .env.example .env

# آدرس سایت:
#   لوکال:  sinshin.localhost   ← https با CA داخلی، بی‌درسر
#   سرور:   food.example.com    ← گواهی ACME خودکار
DOMAIN=sinshin.localhost

# ایمیل اکانت ACME — فقط برای دامنه‌ی واقعی معنا دارد
ACME_EMAIL=dev@sinshin.localhost

# مستندات API از بیرون قابل دیدن باشد؟
#   لوکال: true    ← برای توسعه راحت است
#   سرور:  false   ← اجباری؛ فراموشش نکن
SWAGGER_ENABLED=true