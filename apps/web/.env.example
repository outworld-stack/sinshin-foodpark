# ── آدرس سایت — یک کلید برای کل فرانت ─────────────────
# URL های canonical (og:url)، لینک QR، لینک معرف — همه از این مشتق می‌شوند.
# وقتی دامنه‌ی واقعی فعال شد، فقط همین را عوض کن.
#
# ⚠ متغیرهای VITE_ در زمان build داخل باندل عریان می‌شوند؛
#   بعد از تغییرش، ایمیج docker را دوباره بساز.
VITE_SITE_URL=https://sinshin.localhost

# ── API (فقط سمت سرور — server functions / Eden SSR) ─────
# اجرای اپ روی خود سیستم: http://localhost:3000
# در حالت docker توسط compose بازنویسی می‌شود (http://api:3000)
API_URL=http://localhost:3000