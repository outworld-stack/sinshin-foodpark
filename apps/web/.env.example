# ── Site address — ONE switch for the whole frontend ─────────────────
# Canonical URLs (og:url, canonical), QR links, referral links all
# derive from this. When the real domain goes live, change only this.
VITE_SITE_URL=https://sinshin.localhost

# ── API (server-side only — used by server functions / Eden SSR) ─────
# Inside docker-compose: http://api:3000 (service name on sinshin_edge).
# Local non-docker development: http://localhost:3000
API_URL=http://api:3000