# ─── دیتابیس (شبکه‌ی docker) ───
# ⚠ این فایل مالِ حالت docker است؛ برای اجرای اپ روی خود سیستم
#    فایل .env.local را بساز (توضیح پایین همین فایل).
# (اگر دیتابیس از قبل داری، پسورد همان بماند)
POSTGRES_USER=sinshin
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=sinshin
DATABASE_URL=postgres://sinshin:CHANGE_ME_STRONG@postgres:5432/sinshin

# ─── Redis (شبکه‌ی docker) ───
REDIS_URL=redis://redis:6379

# ─── اپلیکیشن ───
APP_ENV=development
# دامنه‌ی اصلی — در حالت docker توسط compose بازنویسی می‌شود
SITE_URL=http://localhost:3000
# با این دستور بساز:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
SESSION_TTL_DAYS=30
DEVICE_ENFORCEMENT=off
MAX_DEVICES_PER_USER=5

# ─── پیامک ───
# خالی یا console → کد OTP در لاگ چاپ می‌شود (بدون پنل SMS)
#   در dev کد در پاسخ هم برمی‌گردد؛ با APP_ENV=production فقط console آن را
#   برمی‌گرداند → روی سرور واقعی هرگز console نگذار؛ kavenegar یا smsir
SMS_PROVIDER=console

# ─── ابرمدیرها: از محدودیت دستگاه معاف‌اند (۲ مدیر × ۲ شماره) ───
SUPER_ADMIN_PHONES=09121110001,09121110002,09122220003,09122220004

# ─────────────────────────────────────────────────────────────────────────────
# اجرای اپ روی خود سیستم (حالت dev روزمره)؟
# کنار همین فایل، یک فایل apps/api/.env.local بساز با این دو خط:
#
#   DATABASE_URL=postgres://sinshin:CHANGE_ME_STRONG@127.0.0.1:5432/sinshin
#   REDIS_URL=redis://127.0.0.1:6379
#
# بقیه‌ی مقادیر از همین .env ارث می‌رسند؛ فقط آدرس‌ها عوض می‌شوند.
# (تست شده: بانی .env.local را با اولویت بالاتر از .env می‌خواند.
#  گیت هم نگرانی ندارد — .env.* در .gitignore ریشه پوشیده است.)
# ─────────────────────────────────────────────────────────────────────────────