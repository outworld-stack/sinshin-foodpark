# ── App ──────────────────────────────────────────────────────────────
# development | production
# ⚠ production: JWT_SECRET اجباری است، DEV_OTP_IN_RESPONSE=false می‌شود
#   و قانون سوختن دستگاه فعال می‌شود (مگر DEVICE_ENFORCEMENT=off)
APP_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TZ=Asia/Tehran

# ── Site address (single switch for the whole project) ───────────────
# Used in SMS links, QR codes, canonical URLs. No trailing slash.
# برای تغییر دامنه فقط همین و VITE_SITE_URL در apps/web/.env را عوض کنید.
SITE_URL=https://sinshin.localhost

# ── PostgreSQL 18.6 (defaults match docker-compose) ─────────────────
# ⛔ نسخه قفل شده: postgres:18.6-alpine — تغییر ندهید
DATABASE_URL=postgres://sinshin:sinshin_local@postgres:5432/sinshin

# ── Redis (SSE pub/sub, cron locks, OTP store, cache) ───────────────
REDIS_URL=redis://redis:6379

# ── Auth ─────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=change-me-in-production

# ⭐ مدت ماندن کاربر در سایت — بعد از این مدت نیاز به لاگین مجدد (OTP) است.
# فرمت: 30d | 12h | 45m | 90s
SESSION_TTL=30d

# عمر اکسس‌توکن (JWT) — کوتاه و بی‌دردسر؛ کلاینت خودش تمدید می‌کند
ACCESS_TOKEN_TTL=15m

# ── ادمین‌های اصلی (۲ نفر × ۲ شماره) ────────────────────────────────
# ⭐ این شماره‌ها از تمام محدودیت‌های دستگاه معاف‌اند:
#    ثبت‌نام روی هر دستگاهی (حتی سوخته) + دستگاهشان هرگز سوخته نمی‌شود.
# نقش MAIN_ADMIN هم به‌صورت خودکار روی این شماره‌ها ست می‌شود.
SUPER_ADMIN_1_PHONES=09121112221,09121112222
SUPER_ADMIN_2_PHONES=09121112231,09121112232

# (قدیمی — اختیاری) اگر پر شود با شماره‌های بالا ادغام می‌شود
MAIN_ADMIN_PHONES=

# ── Device rules ─────────────────────────────────────────────────────
# auto = در production فعال، در development غیرفعال (پیش‌فرض)
# on   = همیشه فعال (تست رفتار پروداکشن)
# off  = همیشه غیرفعال (فقط برای تست! در production هشدار می‌گیرد)
DEVICE_ENFORCEMENT=auto

# ── OTP tuning ───────────────────────────────────────────────────────
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=90
OTP_HOURLY_PER_PHONE=5
OTP_HOURLY_PER_DEVICE=5
# Return the OTP code in the /otp/request response (dev only; forced false in production)
DEV_OTP_IN_RESPONSE=true

# ── SMS gateway (your provider — wired in the next step) ────────────
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER=

# ── Coupon cron jobs (Asia/Tehran) ──────────────────────────────────
# 02:00 — off-peak nightly scan: find users missing exactly ONE condition
COUPON_SCAN_TIME=02:00
# 11:00 — send "one step away" SMS before lunch
COUPON_NUDGE_TIME=11:00